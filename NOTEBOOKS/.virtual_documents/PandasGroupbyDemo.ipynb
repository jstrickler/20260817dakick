


import pandas as pd
import numpy as np


df = pd.read_csv('../DATA/example_data.txt')
df


df['mean_2_3'] = df[['value_2', 'value_3']].mean(axis=1)
df


g = df.groupby(['run_id'])
for run_id, data in g:
    print(run_id)
    print(data)
    print()


for run_id, data in g:
    print(data.describe(), '\n')



for key, data in g:
    print("run ID:", key)
    print('value_2 mean:', data['value_2'].mean())
    print('value_3 mean:', data['value_3'].mean())
    print('=' * 20)



import seaborn as sns
import  matplotlib.pyplot as plt
chi = pd.read_csv(
    "../DATA/city-of-chicago-salaries.csv", converters={"Employee Annual Salary": lambda e: float(e[1:])}
)

avg_salaries = chi.groupby('Department')['Employee Annual Salary'].mean().sort_values( ascending=False)
avg_salaries.columns = ['Average Salary']
avg_salaries



